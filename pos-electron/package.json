{
  "name": "athr-pos-electron",
  "version": "1.5.1",
  "private": true,
  "description": "ATHR Operations POS – offline-first Electron workspace",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "tsc && vite build && tsc -p tsconfig.electron.json",
    "typecheck": "tsc --noEmit --pretty false && tsc -p tsconfig.electron.json --noEmit --pretty false",
    "start": "electron .",
    "test": "vitest run",
    "test:soft": "npm test && npm run build",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@athr/domain-core": "^0.1.0",
    "axios": "^1.7.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "sql.js": "^1.10.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.2",
    "copyfiles": "^2.4.1",
    "cross-env": "^7.0.3",
    "electron": "41.10.5",
    "electron-builder": "26.15.3",
    "typescript": "^5.4.0",
    "vite": "6.4.3",
    "vitest": "3.2.6",
    "wait-on": "^7.2.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.62.2",
    "@rollup/rollup-win32-x64-msvc": "4.62.2"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "postcss": "8.5.23"
  },
  "build": {
    "appId": "com.athr.operations.pos",
    "productName": "ATHR POS",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "artifactName": "ATHR-POS-Setup-${version}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "ATHR POS"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "extraResources": [
      {
        "from": "node_modules/sql.js/dist/sql-wasm.wasm",
        "to": "sql-wasm.wasm"
      },
      {
        "from": "build/icon.png",
        "to": "app-icon.png"
      }
    ]
  }
}
