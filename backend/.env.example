# Environment identity.
NODE_ENV="development"
BUSINESS_TIME_ZONE="Africa/Cairo"

# PostgreSQL. Prisma runtime traffic uses a bounded pool instead of deriving a
# potentially oversized pool from host CPU count. DIRECT_URL remains reserved
# for migrations and administration.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bold_pos?connection_limit=5&pool_timeout=10&connect_timeout=15"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/bold_pos?connect_timeout=30"
DB_POOL_WARM_CONNECTIONS=5

# Interactive sale transactions. These defaults avoid Prisma's 5-second
# transaction timeout while keeping a bounded wait for a pool connection.
SALE_TRANSACTION_MAX_WAIT_MS=10000
SALE_TRANSACTION_TIMEOUT_MS=30000

# Generate with: openssl rand -hex 32
# Copying this placeholder into a runtime .env intentionally fails startup.
JWT_SECRET="REPLACE_WITH_A_UNIQUE_64_HEX_JWT_SECRET"

# The plain offline context controls how long a newly opened till may continue
# selling without connectivity. It is not a cryptographic acceptance gate:
# completed local sales remain uploadable after this window.
POS_OFFLINE_CONTEXT_TTL_MS=86400000

JWT_EXPIRES="15m"
REFRESH_EXPIRES="30d"

PORT=3000
CORS_ORIGINS="http://localhost:3001,http://localhost:5173,file://,null"
AUTH_RECHECK_TTL_MS=1000
LIST_COUNT_CACHE_MS=5000
SLOW_REQUEST_MS=500
HTTP_TIMING_LOGS=false
POS_ONLINE_THRESHOLD_MS=90000
POS_ENROLLMENT_TTL_MS=600000
POS_PRICE_CATALOG_TTL_MS=86400000

# POS/backend wire compatibility. Keep missing protocol headers accepted during
# the rollout; set POS_REQUIRE_PROTOCOL_HEADERS=true only after all installed
# tills have upgraded to a build that sends x-pos-protocol-version.
POS_PROTOCOL_MIN=2
POS_PROTOCOL_MAX=2
POS_MIN_APP_VERSION="1.4.0"
POS_REQUIRE_PROTOCOL_HEADERS=false

# Clean-cutover production seed. Configure these only for the maintenance
# window, run `npm run prisma:seed:production`, then remove the password and
# confirmation variables from the service.
PRODUCTION_SEED_CONFIRMATION=""
PRODUCTION_SEED_PROJECT_REF=""
PRODUCTION_SEED_BRANCH_CODE=""
PRODUCTION_SEED_BRANCH_NAME_AR=""
PRODUCTION_SEED_BRANCH_NAME_EN=""
PRODUCTION_SEED_BRANCH_ADDRESS=""
PRODUCTION_SEED_BRANCH_PHONE=""
PRODUCTION_SEED_OWNER_NAME=""
PRODUCTION_SEED_OWNER_PHONE=""
PRODUCTION_SEED_OWNER_EMAIL=""
PRODUCTION_SEED_OWNER_PASSWORD=""

# Optional POS update manifest. Leave all three primary values empty to disable
# update offers. The installer URL must be public HTTPS and the checksum must be
# the lowercase or uppercase SHA-256 of that exact installer file.
POS_UPDATE_VERSION=""
POS_UPDATE_URL=""
POS_UPDATE_SHA256=""
POS_UPDATE_NOTES=""
POS_UPDATE_MANDATORY=false
POS_UPDATE_PUBLISHED_AT=""

SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
REPORT_EMAIL_TO=""
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
REPORT_WHATSAPP_TO=""
