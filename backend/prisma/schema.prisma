generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Branch {
  id                       String                  @id @default(uuid()) @db.Uuid
  code                     String
  name_ar                  String
  name_en                  String?
  address                  String?
  phone                    String?
  cash_drawer_enabled      Boolean                 @default(false)
  is_active                Boolean                 @default(true)
  created_at               DateTime                @default(now())
  tenant_id                String                  @db.Uuid
  users                    User[]
  inventory                InventoryStock[]
  inventory_movements      InventoryMovement[]
  inventory_cost_movements InventoryCostMovement[]
  purchase_invoices        PurchaseInvoice[]
  supplier_returns         SupplierReturn[]
  sales                    SalesInvoice[]
  shifts                   Shift[]
  returns                  Return[]
  outgoing_transfers       Transfer[]              @relation("TransferFromBranch")
  incoming_transfers       Transfer[]              @relation("TransferToBranch")
  offer_suggestions        OfferSuggestion[]
  pos_terminals            PosTerminal[]
  pos_enrollment_codes     PosTerminalEnrollment[]

  @@unique([tenant_id, code])
  @@unique([tenant_id, id])
  @@index([tenant_id])
}

model User {
  id                         String                      @id @default(uuid()) @db.Uuid
  branch_id                  String?                     @db.Uuid
  branch                     Branch?                     @relation(fields: [branch_id], references: [id])
  name                       String
  phone                      String?                     @unique
  email                      String?                     @unique
  password_hash              String
  role                       Role
  granted_capabilities       String[]                    @default([])
  revoked_capabilities       String[]                    @default([])
  is_active                  Boolean                     @default(true)
  created_at                 DateTime                    @default(now())
  created_returns            Return[]                    @relation("ReturnCreatedBy")
  created_transfers          Transfer[]                  @relation("TransferCreatedBy")
  shipped_transfers          Transfer[]                  @relation("TransferShippedBy")
  received_transfers         Transfer[]                  @relation("TransferReceivedBy")
  cancelled_transfers        Transfer[]                  @relation("TransferCancelledBy")
  transfer_commands          TransferCommand[]           @relation("TransferCommandCreatedBy")
  transfer_transit_movements TransferTransitMovement[]   @relation("TransferTransitMovementCreatedBy")
  opened_shifts              Shift[]                     @relation("ShiftOpenedBy")
  closed_shifts              Shift[]                     @relation("ShiftClosedBy")
  reviewed_offers            OfferSuggestion[]           @relation("OfferReviewedBy")
  refresh_tokens             RefreshToken[]
  created_pos_enrollments    PosTerminalEnrollment[]     @relation("TerminalEnrollmentCreatedBy")
  enrolled_pos_terminals     PosTerminal[]               @relation("TerminalEnrolledBy")
  originated_sales           SalesInvoice[]              @relation("SalesOriginCashier")
  attributed_sales           SalesInvoice[]              @relation("SalesSeller")
  received_sales             SalesInvoice[]              @relation("SalesReceivedBy")
  inventory_movements        InventoryMovement[]         @relation("InventoryMovementCreatedBy")
  inventory_cost_movements   InventoryCostMovement[]     @relation("InventoryCostMovementCreatedBy")
  created_purchase_invoices  PurchaseInvoice[]           @relation("PurchaseCreatedBy")
  reversed_purchase_invoices PurchaseInvoice[]           @relation("PurchaseReversedBy")
  created_supplier_returns   SupplierReturn[]            @relation("SupplierReturnCreatedBy")
  seller_commission_override SellerCommissionOverride?
  closed_seller_periods      SellerCommissionPeriod[]    @relation("SellerPeriodClosedBy")
  seller_period_rows         SellerCommissionPeriodRow[] @relation("SellerPeriodSeller")
  memberships                Membership[]
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  token_hash String    @unique
  expires_at DateTime
  revoked_at DateTime?
  created_at DateTime  @default(now())

  @@index([user_id, expires_at])
}

enum Role {
  owner
  branch_manager
  cashier
  warehouse_manager
  seller
}

// WP-005 Phase B (MT-MIG-001/002/003): Tenant/Organization/LegalEntity/Location/
// Warehouse/Membership foundation. Additive only — see docs/adr/0002-0006 and
// docs/runbooks/tenant-migration-backfill-rollback.md.
enum TenantAccessMode {
  provisioning
  internal_demo
  trial
  active
  payment_grace
  read_only
  restricted
  suspended
  closure_requested
  closed
  deletion_pending
}

model Tenant {
  id                    String               @id @default(uuid()) @db.Uuid
  name                  String
  access_mode           TenantAccessMode     @default(active)
  default_locale        String               @default("ar")
  default_timezone      String               @default("Africa/Cairo")
  default_currency      String               @default("EGP")
  created_at            DateTime             @default(now())
  updated_at            DateTime             @updatedAt
  organization_profile  OrganizationProfile?
  legal_entities        LegalEntity[]
  locations             Location[]
  warehouses            Warehouse[]
  memberships           Membership[]
  invitations           Invitation[]
  support_access_grants SupportAccessGrant[]
}

model OrganizationProfile {
  id           String   @id @default(uuid()) @db.Uuid
  tenant_id    String   @unique @db.Uuid
  tenant       Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  display_name String
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
}

model LegalEntity {
  id         String     @id @default(uuid()) @db.Uuid
  tenant_id  String     @db.Uuid
  tenant     Tenant     @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  legal_name String
  is_primary Boolean    @default(true)
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt
  locations  Location[]

  @@index([tenant_id])
}

// NOTE: tenantId/identityId are camelCase (not this file's usual snake_case)
// because docs/runbooks/tenant-migration-backfill-rollback.md's Accepted,
// literal validation queries reference them as `l."tenantId"`, `m."tenantId"`,
// `m."identityId"` — matched exactly so those queries run unmodified.
model Location {
  id              String      @id @default(uuid()) @db.Uuid
  tenantId        String      @db.Uuid
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  legal_entity_id String      @db.Uuid
  legal_entity    LegalEntity @relation(fields: [legal_entity_id], references: [id], onDelete: Restrict)
  code            String
  name_ar         String
  name_en         String?
  address         String?
  phone           String?
  is_active       Boolean     @default(true)
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt
  warehouses      Warehouse[]

  @@index([tenantId])
  @@index([legal_entity_id])
}

model Warehouse {
  id             String    @id @default(uuid()) @db.Uuid
  tenant_id      String    @db.Uuid
  tenant         Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  location_id    String?   @db.Uuid
  location       Location? @relation(fields: [location_id], references: [id], onDelete: SetNull)
  name           String
  is_default     Boolean   @default(false)
  is_centralized Boolean   @default(false)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  @@index([tenant_id])
  @@index([location_id])
}

enum MembershipRole {
  tenant_owner
  location_manager
  cashier
  warehouse_manager
  seller
}

enum MembershipStatus {
  invited
  pending_verification
  active
  suspended
  deactivated
  expired
}

model Membership {
  id                       String                  @id @default(uuid()) @db.Uuid
  tenantId                 String                  @db.Uuid
  tenant                   Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  identityId               String                  @db.Uuid
  identity                 User                    @relation(fields: [identityId], references: [id], onDelete: Restrict)
  role                     MembershipRole
  status                   MembershipStatus        @default(active)
  created_at               DateTime                @default(now())
  updated_at               DateTime                @updatedAt
  access_scope_assignments AccessScopeAssignment[]

  @@unique([identityId, tenantId])
  @@index([tenantId])
}

// WP-006 (MT-MIG-005's identity/permission half only — see
// docs/wp/WP-006-identity-membership-permission-model.md): Invitation,
// AccessScopeAssignment, PermissionPolicySnapshot, SupportAccessGrant.
// Additive only. Membership.role/status (above) are untouched; these new
// tables layer explicit Access Scope (BR-SCP-*) and a versioned permission
// catalog (ADR-0005) on top of the existing Membership row, and a
// time-boxed, audited Support Access grant (ADR-0006) that is never a
// standing Membership.
enum InvitationStatus {
  pending
  accepted
  expired
  revoked
}

enum AccessScopeType {
  tenant_wide
  location
  warehouse
  terminal
}

enum SupportAccessMode {
  metadata_only
  read_only_diagnostic
  assisted_operation
  break_glass
}

model Invitation {
  id                     String           @id @default(uuid()) @db.Uuid
  tenant_id              String           @db.Uuid
  tenant                 Tenant           @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  email                  String
  role                   MembershipRole
  scope_type             AccessScopeType
  scope_ref_id           String?          @db.Uuid
  token_hash             String           @unique
  status                 InvitationStatus @default(pending)
  // Soft actor references only (no Prisma relation/FK to User), matching the
  // existing AuditLog.user_id convention — this module does not touch User.
  invited_by_id          String?          @db.Uuid
  purpose                String?
  expires_at             DateTime
  accepted_at            DateTime?
  accepted_membership_id String?          @db.Uuid
  revoked_at             DateTime?
  created_at             DateTime         @default(now())
  updated_at             DateTime         @updatedAt

  @@index([tenant_id])
  @@index([tenant_id, email])
}

model AccessScopeAssignment {
  id             String          @id @default(uuid()) @db.Uuid
  membership_id  String          @db.Uuid
  membership     Membership      @relation(fields: [membership_id], references: [id], onDelete: Cascade)
  // BR-SCP-101: scope_type is always required (no nullable/absent state is
  // representable), and scope_ref_id is required for every type except
  // tenant_wide — enforced at the service layer, not by a DB CHECK, so the
  // application error path (ACCESS_SCOPE_REFERENCE_REQUIRED) stays uniform.
  scope_type     AccessScopeType
  scope_ref_id   String?         @db.Uuid
  grant_source   String          @db.VarChar(64)
  effective_from DateTime        @default(now())
  effective_to   DateTime?
  created_at     DateTime        @default(now())

  @@index([membership_id])
}

// Global, platform-wide catalog — system roles are not tenant-editable in
// MVP (ADR-0003 item 6), so this snapshot is versioned once, not per-tenant.
model PermissionPolicySnapshot {
  id         String   @id @default(uuid()) @db.Uuid
  version    Int      @unique
  grants     Json
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
}

model SupportAccessGrant {
  id                      String            @id @default(uuid()) @db.Uuid
  tenant_id               String            @db.Uuid
  tenant                  Tenant            @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  // Platform Operator identity is intentionally not a Prisma relation to
  // User: ADR-0006 item 1 requires a Platform Operator never be a standing
  // Tenant Membership, and there is no Platform Operator identity table in
  // this WP's scope (support-tooling UI/auth is a later WP) — this is a
  // soft reference, same convention as AuditLog.user_id.
  operator_identity_id    String            @db.Uuid
  mode                    SupportAccessMode
  purpose                 String
  scopes                  Json
  read_only               Boolean           @default(true)
  approved_by_identity_id String?           @db.Uuid
  consent_obtained        Boolean           @default(false)
  starts_at               DateTime          @default(now())
  expires_at              DateTime
  revoked_at              DateTime?
  revoked_reason          String?
  reason                  String
  created_at              DateTime          @default(now())

  @@index([tenant_id])
  @@index([tenant_id, expires_at])
}

model SellerCommissionSettings {
  id                 Int      @id @default(1)
  default_rate       Decimal  @default(0) @db.Decimal(5, 2)
  default_target     Decimal? @db.Decimal(12, 2)
  default_bonus      Decimal  @default(0) @db.Decimal(12, 2)
  period_length_days Int      @default(30)
  period_anchor      DateTime @default(now())
  updated_at         DateTime @updatedAt
  tenant_id          String   @db.Uuid

  @@index([tenant_id])
}

model SellerCommissionOverride {
  seller_id  String   @id @db.Uuid
  seller     User     @relation(fields: [seller_id], references: [id], onDelete: Cascade)
  rate       Decimal? @db.Decimal(5, 2)
  target     Decimal? @db.Decimal(12, 2)
  bonus      Decimal? @db.Decimal(12, 2)
  updated_at DateTime @updatedAt
  tenant_id  String   @db.Uuid

  @@index([tenant_id])
}

model SellerCommissionPeriod {
  id                   String                      @id @default(uuid()) @db.Uuid
  period_start         DateTime
  period_end_exclusive DateTime
  period_length_days   Int
  default_rate         Decimal                     @db.Decimal(5, 2)
  default_target       Decimal?                    @db.Decimal(12, 2)
  default_bonus        Decimal                     @db.Decimal(12, 2)
  closed_by            String                      @db.Uuid
  closer               User                        @relation("SellerPeriodClosedBy", fields: [closed_by], references: [id], onDelete: Restrict)
  closed_at            DateTime                    @default(now())
  rows                 SellerCommissionPeriodRow[]
  tenant_id            String                      @db.Uuid

  @@unique([tenant_id, period_start, period_end_exclusive], map: "SellerCommissionPeriod_tenant_period_dates_key")
  @@unique([tenant_id, id])
  @@index([closed_at(sort: Desc)])
  @@index([tenant_id])
}

model SellerCommissionPeriodRow {
  period_id              String                 @db.Uuid
  period                 SellerCommissionPeriod @relation(fields: [tenant_id, period_id], references: [tenant_id, id], onDelete: Cascade)
  seller_id              String                 @db.Uuid
  seller                 User                   @relation("SellerPeriodSeller", fields: [seller_id], references: [id], onDelete: Restrict)
  seller_name            String
  branch_id              String?                @db.Uuid
  branch_name            String?
  invoice_count          Int
  gross_sales_before_tax Decimal                @db.Decimal(12, 2)
  return_count           Int
  returns_before_tax     Decimal                @db.Decimal(12, 2)
  net_sales_before_tax   Decimal                @db.Decimal(12, 2)
  commission_rate        Decimal                @db.Decimal(5, 2)
  percentage_commission  Decimal                @db.Decimal(12, 2)
  target                 Decimal?               @db.Decimal(12, 2)
  target_achieved        Boolean
  target_bonus           Decimal                @db.Decimal(12, 2)
  estimated_total        Decimal                @db.Decimal(12, 2)
  tenant_id              String                 @db.Uuid

  @@id([period_id, seller_id])
  @@index([seller_id, period_id])
  @@index([tenant_id])
}

model Supplier {
  id               String            @id @default(uuid()) @db.Uuid
  name             String
  company_name     String?
  phone            String?
  alias_names      String[]
  created_at       DateTime          @default(now())
  purchases        PurchaseInvoice[]
  supplier_returns SupplierReturn[]
  tenant_id        String            @db.Uuid

  @@unique([tenant_id, id])
  @@index([tenant_id])
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  name_ar   String
  name_en   String?
  parent_id String?   @db.Uuid
  products  Product[]
  tenant_id String    @db.Uuid

  @@unique([tenant_id, id])
  @@index([tenant_id])
}

model Product {
  id           String           @id @default(uuid()) @db.Uuid
  sku_base     String?
  name_en      String
  name_ar      String?
  category_id  String?          @db.Uuid
  category     Category?        @relation(fields: [tenant_id, category_id], references: [tenant_id, id], onDelete: SetNull)
  brand        String?
  image_url    String?
  is_active    Boolean          @default(true)
  has_variants Boolean          @default(true)
  created_at   DateTime         @default(now())
  variants     ProductVariant[]
  tenant_id    String           @db.Uuid

  @@unique([tenant_id, sku_base])
  @@unique([tenant_id, id])
  @@index([is_active, created_at])
  @@index([name_en(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_name_en_trgm_idx")
  @@index([name_ar(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_name_ar_trgm_idx")
  @@index([tenant_id])
}

model ProductVariant {
  id                         String                    @id @default(uuid()) @db.Uuid
  product_id                 String                    @db.Uuid
  product                    Product                   @relation(fields: [tenant_id, product_id], references: [tenant_id, id], onDelete: Cascade)
  sku                        String
  barcode_ean13              String?
  barcode_internal           String?
  size                       String?
  color                      String?
  style                      String?
  cost_price                 Decimal                   @db.Decimal(12, 2)
  return_count               Int                       @default(0)
  qa_flag                    Boolean                   @default(false)
  is_active                  Boolean                   @default(true)
  created_at                 DateTime                  @default(now())
  inventory                  InventoryStock[]
  inventory_movements        InventoryMovement[]
  inventory_cost_movements   InventoryCostMovement[]
  sales_items                SalesInvoiceItem[]
  purchase_items             PurchaseInvoiceItem[]
  supplier_return_items      SupplierReturnItem[]
  transfer_items             TransferItem[]
  transfer_transit_movements TransferTransitMovement[]
  return_items               ReturnItem[]
  offer_suggestions          OfferSuggestion[]
  tenant_id                  String                    @db.Uuid

  @@unique([tenant_id, sku])
  @@unique([tenant_id, barcode_internal])
  @@unique([tenant_id, id])
  @@index([barcode_ean13])
  @@index([created_at(sort: Desc), id(sort: Asc)])
  @@index([product_id])
  @@index([sku(ops: raw("gin_trgm_ops"))], type: Gin, map: "ProductVariant_sku_trgm_idx")
  @@index([tenant_id])
}

model PricingRule {
  id               String  @id @default(uuid()) @db.Uuid
  name             String
  scope_type       String
  // UUID string for variant/product/category scopes; brand name for brand scope.
  scope_id         String?
  overhead_percent Decimal @default(0) @db.Decimal(5, 2)
  profit_percent   Decimal @default(0) @db.Decimal(5, 2)
  tax_percent      Decimal @default(14) @db.Decimal(5, 2)
  formula          String  @default("compound")
  is_protected     Boolean @default(false)
  priority         Int     @default(100)
  is_active        Boolean @default(true)
  tenant_id        String  @db.Uuid

  @@index([tenant_id])
}

model InventoryStock {
  branch_id    String         @db.Uuid
  variant_id   String         @db.Uuid
  branch       Branch         @relation(fields: [tenant_id, branch_id], references: [tenant_id, id], onDelete: Restrict)
  variant      ProductVariant @relation(fields: [tenant_id, variant_id], references: [tenant_id, id], onDelete: Restrict)
  qty_on_hand  Int            @default(0)
  qty_reserved Int            @default(0)
  last_sold_at DateTime?
  tenant_id    String         @db.Uuid

  @@id([branch_id, variant_id])
  @@index([variant_id])
  @@index([tenant_id])
}

enum InventoryMovementType {
  opening_balance
  sale
  return
  purchase_receipt
  transfer_out
  transfer_in
  adjustment
  stock_count
  reservation
  reservation_release
  cancellation
  reversal
}

model InventoryMovement {
  id                String                @id @default(uuid()) @db.Uuid
  sequence          BigInt                @unique @default(autoincrement())
  branch_id         String                @db.Uuid
  branch            Branch                @relation(fields: [tenant_id, branch_id], references: [tenant_id, id], onDelete: Restrict)
  variant_id        String                @db.Uuid
  variant           ProductVariant        @relation(fields: [tenant_id, variant_id], references: [tenant_id, id], onDelete: Restrict)
  movement_type     InventoryMovementType
  on_hand_delta     Int
  reserved_delta    Int                   @default(0)
  on_hand_after     Int
  reserved_after    Int
  reference_type    String                @db.VarChar(64)
  reference_id      String                @db.VarChar(128)
  reference_line_id String?               @db.VarChar(128)
  idempotency_key   String                @unique @db.VarChar(191)
  occurred_at       DateTime
  recorded_at       DateTime              @default(now())
  created_by        String?               @db.Uuid
  creator           User?                 @relation("InventoryMovementCreatedBy", fields: [created_by], references: [id], onDelete: SetNull)
  metadata          Json?
  tenant_id         String                @db.Uuid

  @@index([branch_id, variant_id, occurred_at])
  @@index([variant_id, sequence], map: "InventoryMovement_variant_sequence_idx")
  @@index([reference_type, reference_id])
  @@index([movement_type, occurred_at])
  @@index([recorded_at])
  @@index([created_by, occurred_at])
  @@index([tenant_id])
}

enum InventoryCostMovementType {
  opening_balance
  purchase_receipt
  purchase_reversal
  supplier_return
  customer_return
  adjustment
}

model InventoryCostMovement {
  id                       String                    @id @default(uuid()) @db.Uuid
  sequence                 BigInt                    @unique @default(autoincrement())
  variant_id               String                    @db.Uuid
  variant                  ProductVariant            @relation(fields: [tenant_id, variant_id], references: [tenant_id, id], onDelete: Restrict)
  branch_id                String?                   @db.Uuid
  branch                   Branch?                   @relation(fields: [tenant_id, branch_id], references: [tenant_id, id], onDelete: Restrict)
  movement_type            InventoryCostMovementType
  quantity_delta           Int
  global_quantity_before   Int
  global_quantity_after    Int
  unit_cost                Decimal                   @db.Decimal(18, 6)
  cost_before              Decimal                   @db.Decimal(12, 2)
  cost_after               Decimal                   @db.Decimal(12, 2)
  inventory_value_before   Decimal                   @db.Decimal(18, 2)
  movement_value           Decimal                   @db.Decimal(18, 2)
  inventory_value_after    Decimal                   @db.Decimal(18, 2)
  rounding_adjustment      Decimal                   @default(0) @db.Decimal(18, 2)
  reference_type           String                    @db.VarChar(64)
  reference_id             String                    @db.VarChar(128)
  reference_line_id        String?                   @db.VarChar(128)
  purchase_invoice_id      String?                   @db.Uuid
  purchase_invoice         PurchaseInvoice?          @relation(fields: [tenant_id, purchase_invoice_id], references: [tenant_id, id], onDelete: Restrict)
  purchase_invoice_item_id String?                   @db.Uuid
  purchase_invoice_item    PurchaseInvoiceItem?      @relation(fields: [tenant_id, purchase_invoice_item_id], references: [tenant_id, id], onDelete: Restrict)
  supplier_return_id       String?                   @db.Uuid
  supplier_return          SupplierReturn?           @relation(fields: [tenant_id, supplier_return_id], references: [tenant_id, id], onDelete: Restrict)
  supplier_return_item_id  String?                   @db.Uuid
  supplier_return_item     SupplierReturnItem?       @relation(fields: [tenant_id, supplier_return_item_id], references: [tenant_id, id], onDelete: Restrict)
  idempotency_key          String                    @unique @db.VarChar(191)
  occurred_at              DateTime
  recorded_at              DateTime                  @default(now())
  created_by               String?                   @db.Uuid
  creator                  User?                     @relation("InventoryCostMovementCreatedBy", fields: [created_by], references: [id], onDelete: SetNull)
  metadata                 Json?
  tenant_id                String                    @db.Uuid

  @@index([variant_id, sequence], map: "InventoryCostMovement_variant_sequence_idx")
  @@index([branch_id, occurred_at], map: "InventoryCostMovement_branch_occurred_at_idx")
  @@index([reference_type, reference_id], map: "InventoryCostMovement_reference_idx")
  @@index([purchase_invoice_id, recorded_at], map: "InventoryCostMovement_purchase_invoice_recorded_at_idx")
  @@index([supplier_return_id, sequence], map: "InventoryCostMovement_supplier_return_sequence_idx")
  @@index([supplier_return_item_id], map: "InventoryCostMovement_supplier_return_item_idx")
  @@index([created_by, occurred_at], map: "InventoryCostMovement_created_by_occurred_at_idx")
  @@index([tenant_id])
}

model Customer {
  id             String         @id @default(uuid()) @db.Uuid
  name           String?
  phone          String?
  whatsapp       String?
  email          String?
  is_vip         Boolean        @default(false)
  vip_price_tier String         @default("cost_plus_overhead")
  total_invoices Int            @default(0)
  total_spent    Decimal        @default(0) @db.Decimal(12, 2)
  created_at     DateTime       @default(now())
  sales          SalesInvoice[]
