generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Branch {
  id                       String                  @id @default(uuid()) @db.Uuid
  code                     String
  name_ar                  String
  name_en                  String?
  address                  String?
  phone                    String?
  cash_drawer_enabled      Boolean                 @default(false)
  is_active                Boolean                 @default(true)
  created_at               DateTime                @default(now())
  tenant_id                String                  @db.Uuid
  users                    User[]
  inventory                InventoryStock[]
  inventory_movements      InventoryMovement[]
  inventory_cost_movements InventoryCostMovement[]
  purchase_invoices        PurchaseInvoice[]
  supplier_returns         SupplierReturn[]
  sales                    SalesInvoice[]
  shifts                   Shift[]
  returns                  Return[]
  outgoing_transfers       Transfer[]              @relation("TransferFromBranch")
  incoming_transfers       Transfer[]              @relation("TransferToBranch")
  offer_suggestions        OfferSuggestion[]
  pos_terminals            PosTerminal[]
  pos_enrollment_codes     PosTerminalEnrollment[]
  assortments              Assortment[]

  @@unique([tenant_id, code])
  @@unique([tenant_id, id])
  @@index([tenant_id])
}

model User {
  id                         String                      @id @default(uuid()) @db.Uuid
  branch_id                  String?                     @db.Uuid
  branch                     Branch?                     @relation(fields: [branch_id], references: [id])
  name                       String
  phone                      String?                     @unique
  email                      String?                     @unique
  password_hash              String
  role                       Role
  granted_capabilities       String[]                    @default([])
  revoked_capabilities       String[]                    @default([])
  is_active                  Boolean                     @default(true)
  created_at                 DateTime                    @default(now())
  created_returns            Return[]                    @relation("ReturnCreatedBy")
  created_transfers          Transfer[]                  @relation("TransferCreatedBy")
  shipped_transfers          Transfer[]                  @relation("TransferShippedBy")
  received_transfers         Transfer[]                  @relation("TransferReceivedBy")
  cancelled_transfers        Transfer[]                  @relation("TransferCancelledBy")
  transfer_commands          TransferCommand[]           @relation("TransferCommandCreatedBy")
  transfer_transit_movements TransferTransitMovement[]   @relation("TransferTransitMovementCreatedBy")
  opened_shifts              Shift[]                     @relation("ShiftOpenedBy")
  closed_shifts              Shift[]                     @relation("ShiftClosedBy")
  reviewed_offers            OfferSuggestion[]           @relation("OfferReviewedBy")
  refresh_tokens             RefreshToken[]
  created_pos_enrollments    PosTerminalEnrollment[]     @relation("TerminalEnrollmentCreatedBy")
  enrolled_pos_terminals     PosTerminal[]               @relation("TerminalEnrolledBy")
  originated_sales           SalesInvoice[]              @relation("SalesOriginCashier")
  attributed_sales           SalesInvoice[]              @relation("SalesSeller")
  received_sales             SalesInvoice[]              @relation("SalesReceivedBy")
  inventory_movements        InventoryMovement[]         @relation("InventoryMovementCreatedBy")
  inventory_cost_movements   InventoryCostMovement[]     @relation("InventoryCostMovementCreatedBy")
  created_purchase_invoices  PurchaseInvoice[]           @relation("PurchaseCreatedBy")
  reversed_purchase_invoices PurchaseInvoice[]           @relation("PurchaseReversedBy")
  created_supplier_returns   SupplierReturn[]            @relation("SupplierReturnCreatedBy")
  seller_commission_override SellerCommissionOverride?
  closed_seller_periods      SellerCommissionPeriod[]    @relation("SellerPeriodClosedBy")
  seller_period_rows         SellerCommissionPeriodRow[] @relation("SellerPeriodSeller")
  memberships                Membership[]
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  token_hash String    @unique
  expires_at DateTime
  revoked_at DateTime?
  created_at DateTime  @default(now())

  @@index([user_id, expires_at])
}

enum Role {
  owner
  branch_manager
  cashier
  warehouse_manager
  seller
}

// WP-005 Phase B (MT-MIG-001/002/003): Tenant/Organization/LegalEntity/Location/
// Warehouse/Membership foundation. Additive only — see docs/adr/0002-0006 and
// docs/runbooks/tenant-migration-backfill-rollback.md.
enum TenantAccessMode {
  provisioning
  internal_demo
  trial
  active
  payment_grace
  read_only
  restricted
  suspended
  closure_requested
  closed
  deletion_pending
}

model Tenant {
  id                    String               @id @default(uuid()) @db.Uuid
  name                  String
  access_mode           TenantAccessMode     @default(active)
  default_locale        String               @default("ar")
  default_timezone      String               @default("Africa/Cairo")
  default_currency      String               @default("EGP")
  created_at            DateTime             @default(now())
  updated_at            DateTime             @updatedAt
  organization_profile  OrganizationProfile?
  legal_entities        LegalEntity[]
  locations             Location[]
  warehouses            Warehouse[]
  memberships           Membership[]
  invitations           Invitation[]
  support_access_grants SupportAccessGrant[]
}

model OrganizationProfile {
  id           String   @id @default(uuid()) @db.Uuid
  tenant_id    String   @unique @db.Uuid
  tenant       Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  display_name String
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
}

model LegalEntity {
  id         String     @id @default(uuid()) @db.Uuid
  tenant_id  String     @db.Uuid
  tenant     Tenant     @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  legal_name String
  is_primary Boolean    @default(true)
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt
  locations  Location[]

  @@index([tenant_id])
}

// NOTE: tenantId/identityId are camelCase (not this file's usual snake_case)
// because docs/runbooks/tenant-migration-backfill-rollback.md's Accepted,
// literal validation queries reference them as `l."tenantId"`, `m."tenantId"`,
// `m."identityId"` — matched exactly so those queries run unmodified.
model Location {
  id              String      @id @default(uuid()) @db.Uuid
  tenantId        String      @db.Uuid
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  legal_entity_id String      @db.Uuid
  legal_entity    LegalEntity @relation(fields: [legal_entity_id], references: [id], onDelete: Restrict)
  code            String
  name_ar         String
  name_en         String?
  address         String?
  phone           String?
  is_active       Boolean     @default(true)
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt
  warehouses      Warehouse[]

  @@index([tenantId])
  @@index([legal_entity_id])
}

model Warehouse {
  id             String    @id @default(uuid()) @db.Uuid
  tenant_id      String    @db.Uuid
  tenant         Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  location_id    String?   @db.Uuid
  location       Location? @relation(fields: [location_id], references: [id], onDelete: SetNull)
  name           String
  is_default     Boolean   @default(false)
  is_centralized Boolean   @default(false)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  @@index([tenant_id])
  @@index([location_id])
}

enum MembershipRole {
  tenant_owner
  location_manager
  cashier
  warehouse_manager
  seller
}

enum MembershipStatus {
  invited
  pending_verification
  active
  suspended
  deactivated
  expired
}

model Membership {
  id                       String                  @id @default(uuid()) @db.Uuid
  tenantId                 String                  @db.Uuid
  tenant                   Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  identityId               String                  @db.Uuid
  identity                 User                    @relation(fields: [identityId], references: [id], onDelete: Restrict)
  role                     MembershipRole
  status                   MembershipStatus        @default(active)
  created_at               DateTime                @default(now())
  updated_at               DateTime                @updatedAt
  access_scope_assignments AccessScopeAssignment[]

  @@unique([identityId, tenantId])
  @@index([tenantId])
}

// WP-006 (MT-MIG-005's identity/permission half only — see
// docs/wp/WP-006-identity-membership-permission-model.md): Invitation,
// AccessScopeAssignment, PermissionPolicySnapshot, SupportAccessGrant.
// Additive only. Membership.role/status (above) are untouched; these new
// tables layer explicit Access Scope (BR-SCP-*) and a versioned permission
// catalog (ADR-0005) on top of the existing Membership row, and a
// time-boxed, audited Support Access grant (ADR-0006) that is never a
// standing Membership.
enum InvitationStatus {
  pending
  accepted
  expired
  revoked
}

enum AccessScopeType {
  tenant_wide
  location
  warehouse
  terminal
}

enum SupportAccessMode {
  metadata_only
  read_only_diagnostic
  assisted_operation
  break_glass
}

model Invitation {
  id                     String           @id @default(uuid()) @db.Uuid
  tenant_id              String           @db.Uuid
  tenant                 Tenant           @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  email                  String
  role                   MembershipRole
  scope_type             AccessScopeType
  scope_ref_id           String?          @db.Uuid
  token_hash             String           @unique
  status                 InvitationStatus @default(pending)
  // Soft actor references only (no Prisma relation/FK to User), matching the
  // existing AuditLog.user_id convention — this module does not touch User.
  invited_by_id          String?          @db.Uuid
  purpose                String?
  expires_at             DateTime
  accepted_at            DateTime?
  accepted_membership_id String?          @db.Uuid
  revoked_at             DateTime?
  created_at             DateTime         @default(now())
  updated_at             DateTime         @updatedAt

  @@index([tenant_id])
  @@index([tenant_id, email])
}

model AccessScopeAssignment {
  id             String          @id @default(uuid()) @db.Uuid
  membership_id  String          @db.Uuid
  membership     Membership      @relation(fields: [membership_id], references: [id], onDelete: Cascade)
  // BR-SCP-101: scope_type is always required (no nullable/absent state is
  // representable), and scope_ref_id is required for every type except
  // tenant_wide — enforced at the service layer, not by a DB CHECK, so the
  // application error path (ACCESS_SCOPE_REFERENCE_REQUIRED) stays uniform.
  scope_type     AccessScopeType
  scope_ref_id   String?         @db.Uuid
  grant_source   String          @db.VarChar(64)
  effective_from DateTime        @default(now())
  effective_to   DateTime?
  created_at     DateTime        @default(now())

  @@index([membership_id])
}

// Global, platform-wide catalog — system roles are not tenant-editable in
// MVP (ADR-0003 item 6), so this snapshot is versioned once, not per-tenant.
model PermissionPolicySnapshot {
  id         String   @id @default(uuid()) @db.Uuid
  version    Int      @unique
  grants     Json
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
}

model SupportAccessGrant {
  id                      String            @id @default(uuid()) @db.Uuid
  tenant_id               String            @db.Uuid
  tenant                  Tenant            @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  // Platform Operator identity is intentionally not a Prisma relation to
  // User: ADR-0006 item 1 requires a Platform Operator never be a standing
  // Tenant Membership, and there is no Platform Operator identity table in
  // this WP's scope (support-tooling UI/auth is a later WP) — this is a
  // soft reference, same convention as AuditLog.user_id.
  operator_identity_id    String            @db.Uuid
  mode                    SupportAccessMode
  purpose                 String
  scopes                  Json
  read_only               Boolean           @default(true)
  approved_by_identity_id String?           @db.Uuid
  consent_obtained        Boolean           @default(false)
  starts_at               DateTime          @default(now())
  expires_at              DateTime
  revoked_at              DateTime?
  revoked_reason          String?
  reason                  String
  created_at              DateTime          @default(now())

  @@index([tenant_id])
  @@index([tenant_id, expires_at])
}

model SellerCommissionSettings {
  id                 Int      @id @default(1)
  default_rate       Decimal  @default(0) @db.Decimal(5, 2)
  default_target     Decimal? @db.Decimal(12, 2)
  default_bonus      Decimal  @default(0) @db.Decimal(12, 2)
  period_length_days Int      @default(30)
  period_anchor      DateTime @default(now())
  updated_at         DateTime @updatedAt
  tenant_id          String   @db.Uuid

  @@index([tenant_id])
}

model SellerCommissionOverride {
  seller_id  String   @id @db.Uuid
  seller     User     @relation(fields: [seller_id], references: [id], onDelete: Cascade)
  rate       Decimal? @db.Decimal(5, 2)
  target     Decimal? @db.Decimal(12, 2)
  bonus      Decimal? @db.Decimal(12, 2)
  updated_at DateTime @updatedAt
  tenant_id  String   @db.Uuid

  @@index([tenant_id])
}

model SellerCommissionPeriod {
  id                   String                      @id @default(uuid()) @db.Uuid
  period_start         DateTime
  period_end_exclusive DateTime
  period_length_days   Int
  default_rate         Decimal                     @db.Decimal(5, 2)
  default_target       Decimal?                    @db.Decimal(12, 2)
  default_bonus        Decimal                     @db.Decimal(12, 2)
  closed_by            String                      @db.Uuid
  closer               User                        @relation("SellerPeriodClosedBy", fields: [closed_by], references: [id], onDelete: Restrict)
  closed_at            DateTime                    @default(now())
  rows                 SellerCommissionPeriodRow[]
  tenant_id            String                      @db.Uuid

  @@unique([tenant_id, period_start, period_end_exclusive], map: "SellerCommissionPeriod_tenant_period_dates_key")
  @@unique([tenant_id, id])
  @@index([closed_at(sort: Desc)])
  @@index([tenant_id])
}

model SellerCommissionPeriodRow {
  period_id              String                 @db.Uuid
  period                 SellerCommissionPeriod @relation(fields: [tenant_id, period_id], references: [tenant_id, id], onDelete: Cascade)
  seller_id              String                 @db.Uuid
  seller                 User                   @relation("SellerPeriodSeller", fields: [seller_id], references: [id], onDelete: Restrict)
  seller_name            String
  branch_id              String?                @db.Uuid
  branch_name            String?
  invoice_count          Int
  gross_sales_before_tax Decimal                @db.Decimal(12, 2)
  return_count           Int
  returns_before_tax     Decimal                @db.Decimal(12, 2)
  net_sales_before_tax   Decimal                @db.Decimal(12, 2)
  commission_rate        Decimal                @db.Decimal(5, 2)
  percentage_commission  Decimal                @db.Decimal(12, 2)
  target                 Decimal?               @db.Decimal(12, 2)
  target_achieved        Boolean
  target_bonus           Decimal                @db.Decimal(12, 2)
  estimated_total        Decimal                @db.Decimal(12, 2)
  tenant_id              String                 @db.Uuid

  @@id([period_id, seller_id])
  @@index([seller_id, period_id])
  @@index([tenant_id])
}

model Supplier {
  id               String            @id @default(uuid()) @db.Uuid
  name             String
  company_name     String?
  phone            String?
  alias_names      String[]
  created_at       DateTime          @default(now())
  purchases        PurchaseInvoice[]
  supplier_returns SupplierReturn[]
  tenant_id        String            @db.Uuid

  @@unique([tenant_id, id])
  @@index([tenant_id])
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  name_ar   String
  name_en   String?
  parent_id String?   @db.Uuid
  products  Product[]
  tenant_id String    @db.Uuid

  @@unique([tenant_id, id])
  @@index([tenant_id])
}

// WP-008 Phase A (BR-CLS-103): Brand is an independent, archivable entity —
// no longer a free-text field on Product. `Product.brand` (string) is kept
// as-is (additive-only phase); `Product.brand_id` is the new FK and the two
// are reconciled by a one-time data migration (one Brand row per distinct
// existing string value per tenant).
model Brand {
  id         String    @id @default(uuid()) @db.Uuid
  tenant_id  String    @db.Uuid
  name       String
  is_active  Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  products   Product[]

  @@unique([tenant_id, id])
  @@unique([tenant_id, name])
  @@index([tenant_id])
}

model Product {
  id              String           @id @default(uuid()) @db.Uuid
  sku_base        String?
  name_en         String
  name_ar         String?
  category_id     String?          @db.Uuid
  category        Category?        @relation(fields: [tenant_id, category_id], references: [tenant_id, id], onDelete: SetNull)
  // Legacy free-text brand — deprecated by `brand_id`/`brand_ref` (BR-CLS-103)
  // but kept until a later phase removes it (this phase is additive-only).
  brand           String?
  brand_id        String?          @db.Uuid
  brand_ref       Brand?           @relation(fields: [tenant_id, brand_id], references: [tenant_id, id], onDelete: Restrict)
  image_url       String?
  is_active       Boolean          @default(true)
  has_variants    Boolean          @default(true)
  // WP-008 Phase C (BR-TAX-201, OD-CAT-014): the product-level *default* tax
  // category. NOT NULL — every product must resolve to a category, which is
  // what stops a line falling back to an implicit rate. Backfilled by
  // `202608130003` before the constraint is applied in `202608130004`.
  tax_category_id String           @db.Uuid
  tax_category    TaxCategory      @relation(fields: [tenant_id, tax_category_id], references: [tenant_id, id], onDelete: Restrict)
  created_at      DateTime         @default(now())
  variants        ProductVariant[]
  tenant_id       String           @db.Uuid

  @@unique([tenant_id, sku_base])
  @@unique([tenant_id, id])
  @@index([tenant_id, tax_category_id])
  @@index([is_active, created_at])
  @@index([name_en(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_name_en_trgm_idx")
  @@index([name_ar(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_name_ar_trgm_idx")
  @@index([tenant_id])
  @@index([brand_id])
}

// WP-008 Phase A (BR-TYP-100): the item-type classification a Variant is
// sold/stocked/serviced under. `bundle_kit_placeholder` reserves the type
// value only — the bundle evaluation engine itself is WP-008 Phase D.
enum ItemType {
  stocked
  non_stock
  service
  bundle_kit_placeholder
}

model ProductVariant {
  id                         String                    @id @default(uuid()) @db.Uuid
  product_id                 String                    @db.Uuid
  product                    Product                   @relation(fields: [tenant_id, product_id], references: [tenant_id, id], onDelete: Cascade)
  sku                        String
  barcode_ean13              String?
  barcode_internal           String?
  size                       String?
  color                      String?
  style                      String?
  cost_price                 Decimal                   @db.Decimal(12, 2)
  return_count               Int                       @default(0)
  qa_flag                    Boolean                   @default(false)
  is_active                  Boolean                   @default(true)
  // BR-TYP-100/101: defaults to `stocked` — every existing Variant today is a
  // physical, inventory-tracked item, so the default preserves current
  // behavior with zero data migration needed for this column.
  item_type                  ItemType                  @default(stocked)
  // BR-TYP-101: a stocked Variant needs a Base stock UOM before inventory
  // tracking can be enabled; nullable because non_stock/service/bundle
  // variants have none, and existing stocked rows have none until assigned.
  base_uom_id                String?                   @db.Uuid
  base_uom                   UnitOfMeasure?            @relation(fields: [tenant_id, base_uom_id], references: [tenant_id, id], onDelete: Restrict)
  // WP-008 Phase C (OD-CAT-014): the variant-level *override*. Nullable by
  // design and it must stay that way — null means "inherit the Product's
  // category", which is the only way an override can be distinguished from a
  // deliberate restatement of the default. Resolution lives in
  // `TaxResolutionService.resolveCategoryId`.
  tax_category_id            String?                   @db.Uuid
  tax_category               TaxCategory?              @relation(fields: [tenant_id, tax_category_id], references: [tenant_id, id], onDelete: Restrict)
  created_at                 DateTime                  @default(now())
  inventory                  InventoryStock[]
  inventory_movements        InventoryMovement[]
  inventory_cost_movements   InventoryCostMovement[]
  sales_items                SalesInvoiceItem[]
  purchase_items             PurchaseInvoiceItem[]
  supplier_return_items      SupplierReturnItem[]
  transfer_items             TransferItem[]
  transfer_transit_movements TransferTransitMovement[]
  return_items               ReturnItem[]
  offer_suggestions          OfferSuggestion[]
  assortments                Assortment[]
  price_overrides            PriceOverride[]
  discounts                  Discount[]
  // WP-008 Phase D (BR-BND-101): a variant may be a component of one or more
  // virtual Bundles. Real FK (unlike Promotion's polymorphic `scope_id`)
  // because a bundle component always names a Variant specifically, never a
  // product/brand/category, so there is no polymorphism to preserve.
  bundle_components          BundleComponent[]
  tenant_id                  String                    @db.Uuid

  @@unique([tenant_id, sku])
  @@unique([tenant_id, barcode_internal])
  @@unique([tenant_id, id])
  @@index([barcode_ean13])
  @@index([created_at(sort: Desc), id(sort: Asc)])
  @@index([product_id])
  @@index([sku(ops: raw("gin_trgm_ops"))], type: Gin, map: "ProductVariant_sku_trgm_idx")
  @@index([tenant_id])
  @@index([base_uom_id])
  @@index([tenant_id, tax_category_id])
}

// WP-008 Phase A (§9 BR-UOM-1xx): tenant-owned reference data — base units
// (piece, kg, ...) and derived units (carton, box, ...) a Variant's stock,
// sale, and purchase quantities are expressed in.
enum UomKind {
  base
  derived
}

model UnitOfMeasure {
  id               String           @id @default(uuid()) @db.Uuid
  tenant_id        String           @db.Uuid
  code             String
  name_en          String
  name_ar          String?
  kind             UomKind          @default(base)
  // BR-UOM-103: max decimal places a quantity in this unit may carry (e.g.
  // 0 for "piece", 3 for "kg"). Enforced at the DTO/service layer.
  precision        Int              @default(0)
  is_active        Boolean          @default(true)
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt
  conversions_from UomConversion[]  @relation("UomConversionFrom")
  conversions_to   UomConversion[]  @relation("UomConversionTo")
  stocked_variants ProductVariant[]

  @@unique([tenant_id, id])
  @@unique([tenant_id, code])
  @@index([tenant_id])
}

enum UomConversionStatus {
  active
  superseded
}

// WP-008 Phase A (BR-UOM-102): versioned and immutable once created — there
// is deliberately no update mutation on this table, only `create` (first
// version) and `supersede` (new version + marks the previous one
// `superseded`). Correcting a wrong factor never rewrites the row a past
// document's snapshot was resolved against.
model UomConversion {
  id               String              @id @default(uuid()) @db.Uuid
  tenant_id        String              @db.Uuid
  from_uom_id      String              @db.Uuid
  from_uom         UnitOfMeasure       @relation("UomConversionFrom", fields: [tenant_id, from_uom_id], references: [tenant_id, id], onDelete: Restrict)
  to_uom_id        String              @db.Uuid
  to_uom           UnitOfMeasure       @relation("UomConversionTo", fields: [tenant_id, to_uom_id], references: [tenant_id, id], onDelete: Restrict)
  // to_uom quantity = from_uom quantity * factor. BR-UOM-102: always positive.
  factor           Decimal             @db.Decimal(18, 6)
  version          Int                 @default(1)
  status           UomConversionStatus @default(active)
  // Plain UUID, not a Prisma relation — a self-referencing composite FK adds
  // real complexity for a pointer the app layer never needs to join through;
  // resolved by id lookup when a caller walks version history.
  superseded_by_id String?             @db.Uuid
  superseded_at    DateTime?
  created_at       DateTime            @default(now())

  @@unique([tenant_id, id])
  @@unique([tenant_id, from_uom_id, to_uom_id, version])
  @@index([tenant_id])
  @@index([from_uom_id])
  @@index([to_uom_id])
}

// WP-008 Phase A (§12 BR-AST-1xx): per-Branch sellability/purchasability,
// distinct from `Product.is_active` (tenant-wide). Keyed on `Branch` — the
// operational root `InventoryStock`/`InventoryMovement` already use today —
// not the not-yet-operationally-wired `Location` model (WP-005), matching
// the precedent `branches.repository.ts` already set for WP-007.
model Assortment {
  id             String         @id @default(uuid()) @db.Uuid
  tenant_id      String         @db.Uuid
  branch_id      String         @db.Uuid
  branch         Branch         @relation(fields: [tenant_id, branch_id], references: [tenant_id, id], onDelete: Cascade)
  variant_id     String         @db.Uuid
  variant        ProductVariant @relation(fields: [tenant_id, variant_id], references: [tenant_id, id], onDelete: Cascade)
  is_sellable    Boolean        @default(true)
  is_purchasable Boolean        @default(true)
  is_displayable Boolean        @default(true)
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt

  @@unique([tenant_id, id])
  @@unique([tenant_id, branch_id, variant_id])
  @@index([tenant_id])
  @@index([branch_id])
  @@index([variant_id])
}

// WP-008 Phase B (BR §13-16): deprecated by "PriceBook"/"PriceBookEntry" --
// kept as-is (forward-only migration policy, no destructive drop) and no
// longer read by "PricingService". Every row was migrated by the
// "202608070001_add_price_book_tables" backfill; see that migration's
// validation block and the Phase B PR description for the exact accounting
// (rows migrated vs. rows reported ambiguous).
model PricingRule {
  id               String  @id @default(uuid()) @db.Uuid
  name             String
  scope_type       String
  // UUID string for variant/product/category scopes; brand name for brand scope.
  scope_id         String?
  overhead_percent Decimal @default(0) @db.Decimal(5, 2)
  profit_percent   Decimal @default(0) @db.Decimal(5, 2)
  tax_percent      Decimal @default(14) @db.Decimal(5, 2)
  formula          String  @default("compound")
  is_protected     Boolean @default(false)
  priority         Int     @default(100)
  is_active        Boolean @default(true)
  tenant_id        String  @db.Uuid

  @@index([tenant_id])
}

// WP-008 Phase B (BR-PRB-1xx): tenant-owned, single-currency (BR-PRB-100,
// OD-CAT-005 -- MVP pilots one operating currency) price list with an
// explicit maker-checker lifecycle (BR-PRB-101, Permission Matrix §17).
// "scope"/"scope_ref_id" model which *book* applies (tenant default vs. a
// narrower location/customer-group/contract/wholesale book per BR-PRB-101's
// examples); only "tenant_default" scope selection is implemented/tested in
// this phase -- see the Phase B PR description for why the others are
// modelled but not yet wired into selection.
enum PriceBookScope {
  tenant_default
  location
  customer_group
  contract
  wholesale
}

enum PriceBookStatus {
  draft
  submitted
  approved
  scheduled
  active
  ended
  archived
}

model PriceBook {
  id             String           @id @default(uuid()) @db.Uuid
  tenant_id      String           @db.Uuid
  name           String
  // BR-PRB-100: one currency per book. Phase B enforces this equals the
  // owning Tenant's "default_currency" (OD-CAT-005 single-operating-currency
  // MVP) at the service layer, not here.
  currency       String
  scope          PriceBookScope   @default(tenant_default)
  scope_ref_id   String?          @db.Uuid
  status         PriceBookStatus  @default(draft)
  // BR-PRB-104: one *active* default book per (currency, scope,
  // scope_ref_id) -- enforced by a partial unique index in the migration
  // (NULLs in "scope_ref_id" collapsed via COALESCE so multiple tenant-wide
  // defaults can't coexist either). The index is scoped to status = 'active'
  // so a replacement can be drafted and scheduled alongside the book it will
  // replace; "PriceBookService.activate" swaps them in one transaction.
  is_default     Boolean          @default(false)
  effective_from DateTime?
  effective_to   DateTime?
  created_by     String?          @db.Uuid
  submitted_by   String?          @db.Uuid
  submitted_at   DateTime?
  approved_by    String?          @db.Uuid
  approved_at    DateTime?
  scheduled_by   String?          @db.Uuid
  scheduled_at   DateTime?
  activated_by   String?          @db.Uuid
  activated_at   DateTime?
  ended_by       String?          @db.Uuid
  ended_at       DateTime?
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt
  entries        PriceBookEntry[]

  @@unique([tenant_id, id])
  @@index([tenant_id])
  @@index([tenant_id, status])
}

// WP-008 Phase B (BR-PSL-100): the entity-level scope a "PriceBookEntry"
// resolves against -- variant -> product -> brand -> category -> global is
// the deterministic priority order "PricingService" walks (same chain the
// legacy "PricingRule.scope_type" approximated).
enum PriceEntryScopeType {
  variant
  product
  brand
  category
  global
}

enum PriceEntryStatus {
  active
  superseded
}

// WP-008 Phase B (BR-PRB-102/103): effective-dated and versioned the same
// way "UomConversion" is (Phase A precedent) -- there is deliberately no
// "update" mutation, only "create" (first version) and "supersede" (new
// version + marks the previous row "superseded"). "min_qty" carries the
// quantity-break threshold (BR-PSL-104): multiple entries may share the same
// ("price_book_id","scope_type","scope_id") at different "min_qty"
// thresholds, and the engine picks the highest qualifying "min_qty" <= the
// requested quantity.
model PriceBookEntry {
  id               String              @id @default(uuid()) @db.Uuid
  tenant_id        String              @db.Uuid
  price_book_id    String              @db.Uuid
  price_book       PriceBook           @relation(fields: [tenant_id, price_book_id], references: [tenant_id, id], onDelete: Restrict)
  scope_type       PriceEntryScopeType
  // Plain UUID, not a Prisma relation -- polymorphic across
  // Variant/Product/Brand/Category (null for "global"), same reason
  // "PricingRule.scope_id" never had an FK either.
  scope_id         String?             @db.Uuid
  min_qty          Decimal             @default(1) @db.Decimal(12, 3)
  // Net, tax-exclusive selling price (BR-PSL-103: never negative, enforced
  // at the service layer and by the migration's validation guard).
  unit_price       Decimal             @db.Decimal(12, 2)
  // BR-PSL-102: a zero price is only valid with this explicit allowance.
  allow_zero_price Boolean             @default(false)
  // SUPERSEDED BY PHASE C — no longer read by "PricingService". The rate now
  // comes from the active "TaxCode" for the priced Variant's tax category
  // (BR-TAX-201). The column is retained, not dropped: this phase is
  // forward-only/non-destructive (CLAUDE.md §6), and the migrated values are
  // the evidence the "202608130003" backfill was derived from. A later WP
  // drops it once nothing references it. Do not reintroduce a read of it —
  // two sources of truth for a charged amount is exactly the failure mode
  // Phase B's sync gap was.
  tax_percent      Decimal             @default(14) @db.Decimal(5, 2)
  // BR-TAX-204: whether "unit_price" already contains tax, for *this* price
  // context. Deliberately has **no database default** — an entry must state
  // it, because a wrong silent default here overcharges or undercharges every
  // sale that resolves to the entry. Existing rows were backfilled to
  // "exclusive" in "202608130005", which is not a guess: the pre-Phase-C
  // engine computed "selling_price = unit_price + unit_price * tax_percent",
  // i.e. it treated every stored price as tax-exclusive.
  tax_mode         TaxMode
  // BR-OVP-102: explicit floor for this entry; a manual override below this
  // requires "pricing.manual-override.above-threshold". Null falls back to
  // the priced Variant's "cost_price" (cost-based floor) at evaluation time.
  floor_price      Decimal?            @db.Decimal(12, 2)
  effective_from   DateTime            @default(now())
  effective_to     DateTime?
  version          Int                 @default(1)
  status           PriceEntryStatus    @default(active)
  superseded_by_id String?             @db.Uuid
  superseded_at    DateTime?
  created_by       String?             @db.Uuid
  created_at       DateTime            @default(now())

  @@unique([tenant_id, id])
  @@index([tenant_id])
  @@index([tenant_id, price_book_id, scope_type, scope_id, status])
}

// WP-008 Phase B (BR-OVP-101): per-role override limits an owner/manager
// configures via "pricing.floor.configure". Absent row for a role = no
// tenant-configured limit (service layer still enforces the floor/approval
// invariants regardless).
model PriceOverridePolicy {
  id                   String         @id @default(uuid()) @db.Uuid
  tenant_id            String         @db.Uuid
  role                 MembershipRole
  max_discount_percent Decimal?       @db.Decimal(5, 2)
  max_discount_amount  Decimal?       @db.Decimal(12, 2)
  allow_price_increase Boolean        @default(true)
  created_at           DateTime       @default(now())
  updated_at           DateTime       @updatedAt

  @@unique([tenant_id, id])
  @@unique([tenant_id, role])
  @@index([tenant_id])
}

// WP-008 Phase B (BR-OVP-100): a manual override is a distinct, audited
// change to the applied unit price at sale time -- never a silent edit to
// the Price Book (BR-OVP-103). "is_below_floor" rows require "approved_by"
// (BR-OVP-102, "pricing.manual-override.above-threshold") before they may be
// applied; enforced in "OverridesService", not by a DB constraint, since the
// approval can be recorded either at request time (pre-approved) or async.
model PriceOverride {
  id             String         @id @default(uuid()) @db.Uuid
  tenant_id      String         @db.Uuid
  variant_id     String         @db.Uuid
  variant        ProductVariant @relation(fields: [tenant_id, variant_id], references: [tenant_id, id], onDelete: Restrict)
  // Opaque caller-supplied reference (e.g. a sale/line id) -- deliberately
  // not an FK so the pricing module stays independent of the sales module
  // (CLAUDE.md §2.2 / Multi-tenancy Blueprint §28).
  reference      String?
  base_price     Decimal        @db.Decimal(12, 2)
  override_price Decimal        @db.Decimal(12, 2)
  floor_price    Decimal?       @db.Decimal(12, 2)
  is_below_floor Boolean        @default(false)
  reason         String
  applied_by     String         @db.Uuid
  approved_by    String?        @db.Uuid
  approved_at    DateTime?
  created_at     DateTime       @default(now())

  @@unique([tenant_id, id])
  @@index([tenant_id])
  @@index([tenant_id, variant_id])
}

// WP-008 Phase B (BR-DSC-200/205): a calculated adjustment, distinct from a
// "PriceOverride" -- never mutates the Price Book. "source" is a plain
// string (not an enum) so a "promotion" value needs no migration when one is
// produced.
//
// WP-008 Phase D update: `Promotion`/`Coupon`/`Bundle` now exist (below), but
// still nothing writes `source: "promotion"` here. Phase D wires promotion
// evaluation into the read-only `POST /pricing/calculate` quote endpoint only
// (see `PromotionEvaluationService` and the Phase D PR description) -- it
// does not touch `SalesService.createSale`, which is where a `Discount` row
// would actually be persisted against a completed sale. That wiring is
// WP-010's, per this WP document's own "Blocks" line. Still only "manual" is
// produced by any code path today.
enum DiscountBasis {
  percentage
  fixed_amount
}

model Discount {
  id          String         @id @default(uuid()) @db.Uuid
  tenant_id   String         @db.Uuid
  variant_id  String         @db.Uuid
  variant     ProductVariant @relation(fields: [tenant_id, variant_id], references: [tenant_id, id], onDelete: Restrict)
  reference   String?
  source      String         @default("manual")
  basis       DiscountBasis
  amount      Decimal        @db.Decimal(12, 2)
  base_price  Decimal        @db.Decimal(12, 2)
  final_price Decimal        @db.Decimal(12, 2)
  reason      String?
  applied_by  String         @db.Uuid
  created_at  DateTime       @default(now())

  @@unique([tenant_id, id])
  @@index([tenant_id])
  @@index([tenant_id, variant_id])
}

// ---------------------------------------------------------------------------
// WP-008 Phase C — Versioned Tax Codes (BR §17, BR-TAX-2xx)
// ---------------------------------------------------------------------------

// BR-TAX-204: a price is inclusive or exclusive of tax *per price context* —
// "لا يمكن لنفس السعر أن يكون شاملًا وغير شامل دون Scope صريحة". Both the
// `TaxCode` (the code's own declared behavior) and the `PriceBookEntry` (the
// context the price was authored in) carry this, and there is deliberately no
// database default on `PriceBookEntry.tax_mode` — see that column.
enum TaxMode {
  inclusive
  exclusive
}

// BR-TAX-200 lists "rate أو calculation method" as alternatives. MVP resolves
// a percentage only; the enum exists so a later compound/fixed-amount method
// is an added value rather than a column migration (BR-TAX-207).
enum TaxCalculationMethod {
  percentage
}

// BR-TAX-200 "rounding policy reference" + BR-RND-201: whether tax rounds per
// line or per document must be declared, and must not differ between POS and
// server. Carried on the code so the snapshot can record which rule applied.
enum TaxRoundingPolicy {
  line
  document
}

// BR-TAX-200 + Permission Matrix §18: the same maker-checker lifecycle
// `PriceBookStatus` uses, with `supersede` in place of `end` — a tax code is
// never "ended", it is replaced by its successor version (BR-TAX-203: the
// past keeps the rate it was charged under).
enum TaxCodeStatus {
  draft
  submitted
  approved
  scheduled
  active
  superseded
  archived
}

/// BR-TAX-201: a Product carries a tax *category*, never a permanent rate.
/// This is that category — tenant-owned reference data, stable across rate
/// changes. The rate is whatever `TaxCode` is active for this category at
/// transaction time, which is what makes BR-TAX-203 possible at all.
model TaxCategory {
  id          String           @id @default(uuid()) @db.Uuid
  tenant_id   String           @db.Uuid
  code        String
  name_en     String
  name_ar     String?
  description String?
  is_active   Boolean          @default(true)
  created_by  String?          @db.Uuid
  created_at  DateTime         @default(now())
  updated_at  DateTime         @updatedAt
  tax_codes   TaxCode[]
  products    Product[]
  variants    ProductVariant[]
  exemptions  TaxExemption[]

  @@unique([tenant_id, id])
  @@unique([tenant_id, code])
  @@index([tenant_id])
  @@index([tenant_id, is_active])
}

/// BR-TAX-200: the versioned tax code itself. Every field the BR lists is
/// modelled here — jurisdiction scope, category, rate/calculation method,
/// inclusive-exclusive behavior, effective period, exemption rules, rounding
/// policy reference — even where the MVP keeps one inert:
///
/// - `jurisdiction` is recorded, **not** resolved. There is no
///   jurisdiction-determination engine in this phase (OD-CAT-006 in the BR
///   doc's §35 numbering; the WP doc cites OD-CAT-007, see the PR note).
///   Single-jurisdiction per tenant stands.
/// - `version`/`supersedes_id` give BR-TAX-203 its teeth: activating v2 never
///   touches v1's row, so a document that snapshotted v1 still reports v1.
model TaxCode {
  id                 String               @id @default(uuid()) @db.Uuid
  tenant_id          String               @db.Uuid
  tax_category_id    String               @db.Uuid
  tax_category       TaxCategory          @relation(fields: [tenant_id, tax_category_id], references: [tenant_id, id], onDelete: Restrict)
  code               String
  name_en            String
  name_ar            String?
  // Recorded scope only — no determination engine in this phase.
  jurisdiction       String               @default("EG")
  calculation_method TaxCalculationMethod @default(percentage)
  // Decimal(7,4): 14.0000. Four decimal places because fractional rates
  // (e.g. 1.5%) are ordinary in the region and 5,2 could not hold them.
  rate               Decimal              @db.Decimal(7, 4)
  tax_mode           TaxMode
  rounding_policy    TaxRoundingPolicy    @default(line)
  // BR-TAX-205: whether this code admits exemptions at all. An exemption is
  // still an evidenced `TaxExemption` row — this only says the code permits
  // one to exist.
  exemption_allowed  Boolean              @default(false)
  effective_from     DateTime?
  effective_to       DateTime?
  version            Int                  @default(1)
  status             TaxCodeStatus        @default(draft)
  supersedes_id      String?              @db.Uuid
  supersedes         TaxCode?             @relation("TaxCodeVersion", fields: [tenant_id, supersedes_id], references: [tenant_id, id], onDelete: Restrict)
  superseded_by      TaxCode[]            @relation("TaxCodeVersion")
  superseded_at      DateTime?
  superseded_by_id   String?              @db.Uuid
  created_by         String?              @db.Uuid
  submitted_by       String?              @db.Uuid
  submitted_at       DateTime?
  approved_by        String?              @db.Uuid
  approved_at        DateTime?
  scheduled_by       String?              @db.Uuid
  scheduled_at       DateTime?
  activated_by       String?              @db.Uuid
  activated_at       DateTime?
  created_at         DateTime             @default(now())
  updated_at         DateTime             @updatedAt
  snapshots          SalesTaxSnapshot[]

  @@unique([tenant_id, id])
  @@unique([tenant_id, code, version])
  @@index([tenant_id])
  @@index([tenant_id, status])
  @@index([tenant_id, tax_category_id, status])
}

/// BR-TAX-205 — "تحفظ Customer/status/reason/reference/expiry عند الحاجة".
/// An exemption is a recorded, auditable decision, never a silent zero: a
/// zero-rated line must point at one of these rows or it is not an exemption,
/// it is a bug.
model TaxExemption {
  id                 String             @id @default(uuid()) @db.Uuid
  tenant_id          String             @db.Uuid
  customer_id        String             @db.Uuid
  customer           Customer           @relation(fields: [tenant_id, customer_id], references: [tenant_id, id], onDelete: Restrict)
  // Null = the exemption covers every category for this customer.
  tax_category_id    String?            @db.Uuid
  tax_category       TaxCategory?       @relation(fields: [tenant_id, tax_category_id], references: [tenant_id, id], onDelete: Restrict)
  status             TaxExemptionStatus @default(pending)
  // The evidence itself. All three are NOT NULL: BR-TAX-205 makes the reason
  // and the reference to the issued certificate part of what an exemption
  // *is*, so there is no way to record one without them.
  reason             String
  evidence_reference String
  evidence_issued_at DateTime
  expires_at         DateTime?
  applied_by         String             @db.Uuid
  approved_by        String?            @db.Uuid
  approved_at        DateTime?
  revoked_by         String?            @db.Uuid
  revoked_at         DateTime?
  revoked_reason     String?
  created_at         DateTime           @default(now())
  updated_at         DateTime           @updatedAt
  snapshots          SalesTaxSnapshot[]

  @@unique([tenant_id, id])
  @@index([tenant_id])
  @@index([tenant_id, customer_id, status])
}

enum TaxExemptionStatus {
  pending
  approved
  rejected
  revoked
  expired
}

/// BR-TAX-202 — "تتضمن code/rate/base/amount/mode/version". All six, plus the
/// resolved `tax_code_id` and the rounding policy that produced `amount`.
///
/// **Why a child table rather than six columns on `SalesInvoiceItem`:**
/// BR-TAX-207 is classified `Architecture Requirement` and states the domain
/// must not preclude multiple tax components on one line later, even though
/// the MVP charges exactly one. Flat columns would preclude it; one row per
/// (line, component) does not. Today the service writes exactly one row per
/// line — see `SalesTaxSnapshotService`.
///
/// Nothing in the application ever updates a row in this table. It is the
/// evidence for BR-TAX-203, and `202608130007`'s trigger enforces that at the
/// database level rather than trusting every future caller to be careful.
model SalesTaxSnapshot {
  id                       String            @id @default(uuid()) @db.Uuid
  tenant_id                String            @db.Uuid
  sales_invoice_id         String            @db.Uuid
  invoice                  SalesInvoice      @relation(fields: [tenant_id, sales_invoice_id], references: [tenant_id, id], onDelete: Cascade)
  sales_invoice_item_id    String            @db.Uuid
  item                     SalesInvoiceItem  @relation(fields: [tenant_id, sales_invoice_item_id], references: [tenant_id, id], onDelete: Cascade)
  // Restrict, not Cascade: a TaxCode that any document snapshotted can never
  // be deleted out from under its own evidence.
  tax_code_id              String            @db.Uuid
  tax_code                 TaxCode           @relation(fields: [tenant_id, tax_code_id], references: [tenant_id, id], onDelete: Restrict)
  // The six BR-TAX-202 fields, denormalised on purpose: reading a historical
  // document must never need a join to a row that may since have changed.
  code_snapshot            String
  rate_snapshot            Decimal           @db.Decimal(7, 4)
  base_amount              Decimal           @db.Decimal(12, 2)
  tax_amount               Decimal           @db.Decimal(12, 2)
  mode_snapshot            TaxMode
  version_snapshot         Int
  rounding_policy_snapshot TaxRoundingPolicy
  // BR-TAX-205: set only when this line was zero-rated by an exemption. A
  // zero `tax_amount` with a null `exemption_id` and a non-zero rate is the
  // "silent zero" the BR forbids — `SalesTaxSnapshotService` rejects it.
  exemption_id             String?           @db.Uuid
  exemption                TaxExemption?     @relation(fields: [tenant_id, exemption_id], references: [tenant_id, id], onDelete: Restrict)
  created_at               DateTime          @default(now())

  @@unique([tenant_id, id])
  @@index([tenant_id])
  @@index([tenant_id, sales_invoice_id])
  @@index([sales_invoice_item_id])
  @@index([tenant_id, tax_code_id])
}

model InventoryStock {
  branch_id    String         @db.Uuid
  variant_id   String         @db.Uuid
  branch       Branch         @relation(fields: [tenant_id, branch_id], references: [tenant_id, id], onDelete: Restrict)
  variant      ProductVariant @relation(fields: [tenant_id, variant_id], references: [tenant_id, id], onDelete: Restrict)
  qty_on_hand  Int            @default(0)
  qty_reserved Int            @default(0)
  last_sold_at DateTime?
  tenant_id    String         @db.Uuid

  @@id([branch_id, variant_id])
  @@index([variant_id])
  @@index([tenant_id])
}

enum InventoryMovementType {
  opening_balance
  sale
  return
  purchase_receipt
  transfer_out
  transfer_in
  adjustment
  stock_count
  reservation
  reservation_release
  cancellation
  reversal
}

model InventoryMovement {
  id                String                @id @default(uuid()) @db.Uuid
  sequence          BigInt                @unique @default(autoincrement())
  branch_id         String                @db.Uuid
  branch            Branch                @relation(fields: [tenant_id, branch_id], references: [tenant_id, id], onDelete: Restrict)
  variant_id        String                @db.Uuid
  variant           ProductVariant        @relation(fields: [tenant_id, variant_id], references: [tenant_id, id], onDelete: Restrict)
  movement_type     InventoryMovementType
  on_hand_delta     Int
  reserved_delta    Int                   @default(0)
  on_hand_after     Int
  reserved_after    Int
  reference_type    String                @db.VarChar(64)
  reference_id      String                @db.VarChar(128)
  reference_line_id String?               @db.VarChar(128)
  idempotency_key   String                @unique @db.VarChar(191)
  occurred_at       DateTime
  recorded_at       DateTime              @default(now())
  created_by        String?               @db.Uuid
  creator           User?                 @relation("InventoryMovementCreatedBy", fields: [created_by], references: [id], onDelete: SetNull)
  metadata          Json?
  tenant_id         String                @db.Uuid

  @@index([branch_id, variant_id, occurred_at])
  @@index([variant_id, sequence], map: "InventoryMovement_variant_sequence_idx")
  @@index([reference_type, reference_id])
  @@index([movement_type, occurred_at])
  @@index([recorded_at])
  @@index([created_by, occurred_at])
  @@index([tenant_id])
}

enum InventoryCostMovementType {
  opening_balance
  purchase_receipt
  purchase_reversal
  supplier_return
  customer_return
  adjustment
}

model InventoryCostMovement {
  id                       String                    @id @default(uuid()) @db.Uuid
  sequence                 BigInt                    @unique @default(autoincrement())
  variant_id               String                    @db.Uuid
  variant                  ProductVariant            @relation(fields: [tenant_id, variant_id], references: [tenant_id, id], onDelete: Restrict)
  branch_id                String?                   @db.Uuid
  branch                   Branch?                   @relation(fields: [tenant_id, branch_id], references: [tenant_id, id], onDelete: Restrict)
  movement_type            InventoryCostMovementType
  quantity_delta           Int
  global_quantity_before   Int
  global_quantity_after    Int
  unit_cost                Decimal                   @db.Decimal(18, 6)
  cost_before              Decimal                   @db.Decimal(12, 2)
  cost_after               Decimal                   @db.Decimal(12, 2)
  inventory_value_before   Decimal                   @db.Decimal(18, 2)
  movement_value           Decimal                   @db.Decimal(18, 2)
  inventory_value_after    Decimal                   @db.Decimal(18, 2)
  rounding_adjustment      Decimal                   @default(0) @db.Decimal(18, 2)
  reference_type           String                    @db.VarChar(64)
  reference_id             String                    @db.VarChar(128)
  reference_line_id        String?                   @db.VarChar(128)
  purchase_invoice_id      String?                   @db.Uuid
